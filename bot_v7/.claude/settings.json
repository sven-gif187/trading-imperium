{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:/Users/<BENUTZER>/Desktop/trading_imperium_v7/.claude/hooks/sitzungsstart.py"
            ],
            "timeout": 20,
            "statusMessage": "Projektgedaechtnis wird vorgelegt"
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:/Users/<BENUTZER>/Desktop/trading_imperium_v7/.claude/hooks/jede_nachricht.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "C:/Users/<BENUTZER>/Desktop/trading_imperium_v7/.claude/hooks/schreibschutz.py"
            ],
            "timeout": 10,
            "statusMessage": "Schreibschutz"
          }
        ]
      }
    ]
  }
}
