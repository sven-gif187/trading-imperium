# ============================================================
# Trading Imperium V6 - Umgebungsvariablen
# ============================================================
# WICHTIG:
# 1. Diese Datei umbenennen zu ".env"
# 2. NIEMALS in Git committen!
# 3. NIEMALS teilen oder hochladen!
# ============================================================

# === BINANCE API (für Live-Trading) ===
# Holen unter: https://www.binance.com/en/my/settings/api-management
# WICHTIG: NUR "Enable Reading" und "Enable Spot Trading"
# NIEMALS "Enable Withdrawals" aktivieren!
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === OPENAI API (optional - für KI-Kontextanalyse, News-Auswertung) ===
# Holen unter: https://platform.openai.com/api-keys
# Falls leer -> KI-Kontext deaktiviert, Bot läuft normal
OPENAI_API_KEY=

# === TELEGRAM (optional - für Push-Notifications) ===
# Bot erstellen mit @BotFather, Chat-ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === NGROK (optional - für öffentlichen Dashboard-Zugriff) ===
# Token holen unter: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ============================================================
# TESTNETZ [21.08.2026] - fuer testnetz_probe.py
# ============================================================
# EIGENE Schluessel vom Binance-Testnetz, NICHT die echten.
# Holen: https://testnet.binance.vision -> mit GitHub anmelden
#        -> "Generate HMAC_SHA256 Key"
#
# Das Testnetz ist eine vollwertige Boerse mit Spielgeld. Der
# Order-Pfad laesst sich damit pruefen, ohne einen Euro zu
# riskieren - und ohne den laufenden Bot anzufassen.
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
